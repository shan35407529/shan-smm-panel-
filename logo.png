<!DOCTYPE html>
<html lang="ur">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHAN PANEL AI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #0f172a; color: white; font-family: sans-serif; }
        header { background: #1e293b; padding: 15px; display: flex; align-items: center; border-bottom: 2px solid cyan; }
        
        /* Logo Styling */
        .logo-container {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 2px solid cyan;
            overflow: hidden;
            margin-right: 12px;
            background: #000;
        }
        .logo-container img { width: 100%; height: 100%; object-fit: cover; }
        
        .panel-title { font-size: 1.1rem; font-weight: bold; color: cyan; flex-grow: 1; }
        .container { padding: 20px; }
        .welcome-card { background: linear-gradient(135deg, #06b6d4, #3b82f6); padding: 25px; border-radius: 15px; text-align: center; margin-bottom: 20px; }
        .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .card { background: #1e293b; padding: 20px; border-radius: 12px; text-align: center; border: 1px solid #334155; }
        .card i { color: cyan; font-size: 1.5rem; margin-bottom: 8px; }
    </style>
</head>
<body>

<header>
    <div class="logo-container">
        <img src="logo.png" alt="SHAN" onerror="this.src='https://via.placeholder.com/50/00ffff/000000?text=AI'">
    </div>
    <div class="panel-title">SHAN PANEL AI</div>
    <i class="fas fa-user-circle fa-2x"></i>
</header>

<div class="container">
    <div class="welcome-card">
        <h2>!خوش آمدید، شان علی</h2>
        <p>بیلنس: $150.00</p>
    </div>

    <div class="stats">
        <div class="card"><i class="fas fa-shopping-cart"></i><h3>0</h3><p>ٹوٹل آرڈرز</p></div>
        <div class="card"><i class="fas fa-wallet"></i><h3>$150</h3><p>بیلنس</p></div>
        <div class="card"><i class="fas fa-ticket-alt"></i><h3>0</h3><p>سپورٹ ٹکٹ</p></div>
        <div class="card"><i class="fas fa-check-circle"></i><h3>Active</h3><p>سٹیٹس</p></div>
    </div>
</div>

</body>
</html>
